    "build:iam": "npm run swagger",
    "start:iam": "tsx services/iam-service/src/index.ts",
    "build:message": "npm run swagger:message",
    "start:message": "tsx services/message-service/src/index.ts",
    "build:chat": "npm run swagger:chat",
    "start:chat": "tsx services/chat-service/src/index.ts",
    "build:notification": "npm run swagger:notification",
    "start:notification": "tsx services/notification-service/src/index.ts",
    "build:patient": "npm run swagger:patient",
    "start:patient": "tsx services/patientService/src/index.ts",
    "build:testOrder": "npm run swagger:testOrder",
    "start:testOrder": "tsx services/testOrderService/src/index.ts",
    "build:warehouse": "npm run swagger:warehouse",
    "build:monitoring": "npm run swagger:monitoring",
    "start:monitoring": "tsx services/monitoringService/src/index.ts",
    "start:warehouse-live": "tsx services/warehouseService/src/index.ts",
    "build": "npm-run-all --parallel swagger:iam swagger:message swagger:chat swagger:notification swagger:patient swagger:testOrder swagger:warehouse swagger:monitoring"
