# Monitoring Service Environment Variables

# Server Configuration
PORT=3004
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/monitoring_service_db
MONGODB_TEST_URI=mongodb://localhost:27017/monitoring_service_test_db

# IAM Service Integration
IAM_SERVICE_URL=http://localhost:3000
INTERNAL_API_KEY=internal-service-secret-key

# JWT Configuration (for authentication)
JWT_SECRET=your-monitoring-service-jwt-secret-key-here
JWT_EXPIRES_IN=24h

# Redis Configuration (optional, for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Logging
LOG_LEVEL=info

# Message Broker (for future integration)
RABBITMQ_URL=amqp://localhost:5672
KAFKA_BROKER=localhost:9092
